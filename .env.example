# ─── Database ─────────────────────────────────────────────────────────
# Local development uses a file-backed SQLite database.
# Production points at a Turso libSQL URL and requires an auth token.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# ─── Auth ─────────────────────────────────────────────────────────────
# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── App ──────────────────────────────────────────────────────────────
# Public URL for auth callbacks. Set to your Vercel domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI Services ─────────────────────────────────────────────────────
# Google Gemini — writing/speaking assessment + lesson feedback.
GOOGLE_AI_API_KEY=

# ElevenLabs — text-to-speech for listening exercises.
ELEVENLABS_API_KEY=

# ─── Email ────────────────────────────────────────────────────────────
# Resend — transactional email (welcome, streak reminders, weekly reports).
RESEND_API_KEY=
EMAIL_FROM=FluentPath <noreply@fluentpath.com>

# ─── Payments ─────────────────────────────────────────────────────────
# Paddle — subscription billing. Get keys from Paddle dashboard.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MAP=

# ─── Security ─────────────────────────────────────────────────────────
# Cron endpoint protection — set a random secret.
CRON_SECRET=

# Comma-separated admin emails for admin dashboard access.
ADMIN_EMAILS=

# ─── Storage ──────────────────────────────────────────────────────────
# Cloudflare R2 — audio file storage. Optional for local dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Analytics ────────────────────────────────────────────────────────
# PostHog — usage analytics (consent-gated, only fires after user accepts).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
